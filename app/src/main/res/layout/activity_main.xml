<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#0B0F14" android:gravity="center_horizontal">
    
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SYSrescue" android:textColor="#00E5FF" android:textSize="28sp" android:gravity="center" android:textStyle="bold" android:layout_marginTop="60dp" android:layout_marginBottom="20dp"/>
    
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Menunggu device..." android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center" android:layout_marginBottom="40dp"/>
    
    <Button android:id="@+id/btnOpenBrowser" android:layout_width="match_parent" android:layout_height="56dp" android:text="🌐 Buka Browser" android:textSize="16sp" android:enabled="false"/>
</LinearLayout>
